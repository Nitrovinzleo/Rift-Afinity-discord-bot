# RiftAffinity Discord Bot - Configuration

# Jeton de Bot Discord (à récupérer sur https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# URL de l'API Backend & Site Web RiftAffinity (Production Vercel)
API_URL=https://rift-afinity-ri-ft-afinity.vercel.app
SITE_URL=https://rift-afinity-ri-ft-afinity.vercel.app

# Clé API Riot Games (ex: RGAPI-xxxx-xxxx)
RIOT_API_KEY=YOUR_RIOT_API_KEY_HERE

# Base de données PostgreSQL Neon (Partagée avec le Backend)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
